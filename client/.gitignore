# ==============================================================================
# RDV Client (Vite / React) - .gitignore
# ==============================================================================

# Dependencies
node_modules/
.pnpm-store/

# Build & distribution
dist/
dist-ssr/
*.local

# Environment variables & secrets
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# OS files
.DS_Store
Thumbs.db
ehthumbs.db

# Misc & caches
.eslintcache
.stylelintcache
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
