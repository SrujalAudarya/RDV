# ==============================================================================
# RDV (Renuka Designers Villa) - Root .gitignore
# Comprehensive Ignore Rules for Entire Project (Client, Server & Root)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Package Manager & Dependencies
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
*/*/node_modules/
.pnpm-store/
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
package-lock.json.bak

# ------------------------------------------------------------------------------
# 2. Build & Distribution Outputs
# ------------------------------------------------------------------------------
dist/
*/dist/
dist-ssr/
*/dist-ssr/
build/
*/build/
out/
*/out/
.next/
.nuxt/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 3. Environment Variables, Credentials & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.env.*
*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
server/.env
server/.env.local
server/.env.production
client/.env
client/.env.local
client/.env.production

# ------------------------------------------------------------------------------
# 4. Logs, Runtime Dumps & Process IDs
# ------------------------------------------------------------------------------
logs/
*.log
*.pid
*.seed
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
client/vite.log

# ------------------------------------------------------------------------------
# 5. Operating System & Local Filesystem Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
Icon?

# ------------------------------------------------------------------------------
# 6. IDEs, Editors & Tooling
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp
*.sublime-project
*.sublime-workspace
.project
.settings/
.classpath

# ------------------------------------------------------------------------------
# 7. Testing, Coverage & Reports
# ------------------------------------------------------------------------------
coverage/
*/coverage/
.nyc_output/
*.lcov
test-results/
cypress/videos/
cypress/screenshots/
.playwright/

# ------------------------------------------------------------------------------
# 8. Caches, Temporary & Scratch Folders
# ------------------------------------------------------------------------------
.cache/
*/.cache/
.vite/
*/.vite/
.eslintcache
.stylelintcache
.prettiercache
tmp/
temp/
.temp/
*.tmp
*.bak
