# ==============================================================================
# RDV Server - .gitignore
# ==============================================================================

# Dependencies
node_modules/
package-lock.json.bak

# Environment variables & secrets (keep .env.example)
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime artifacts & process IDs
*.pid
*.seed
*.pid.lock

# Test & coverage
coverage/
.nyc_output/

# OS & Editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
.idea/
